# プロジェクト環境変数。コピーした .env に必要値を設定する。
# config.py と run.py が使用し、起動時に秘密鍵と DB 接続を検証する。

# 必須: セッション署名用秘密鍵。
SECRET_KEY=

# DB は完全 URI または個別項目のどちらかを設定する。
DATABASE_URI=
# 個別指定:
# DB_HOST=
# DB_PORT=
# DB_USER=
# DB_PASSWORD=
# DB_NAME=

# 任意: プロジェクトルート。未設定時は run.py/logger.py の場所を使用する。
# PROJECT_ROOT=

# ログレベル。
# APP_LOG_LEVEL=INFO

# Flask
# FLASK_ENV=production
# HOST=0.0.0.0
# PORT=5000

# 起動時 DB 初期化。本番では別手順を使用する。
# RUN_DB_INIT=false

# CORS 許可元。カンマ区切りで指定する。
# CORS_ORIGINS=

# リクエスト最大サイズ（バイト）。
# MAX_CONTENT_LENGTH=16777216

# ---------------------------------------------------------------------------
# LLM（utils/llm — call_llm_common / Sakura AI Engine）。
# AI 機能を有効にする前に .env へコピーし、SAKURA_AI_TOKEN を設定する。
# ---------------------------------------------------------------------------
# HV_LLM_ENABLED=true
# HV_LLM_REQUIRE_REAL_API=true
# HV_LLM_DEFAULT_MODEL=cotomi3
# HV_LLM_SYSTEM_PROMPT=
# HV_LLM_TEMPERATURE=0.2
# HV_LLM_MAX_TOKENS=2048
# HV_LLM_RESPONSE_SCHEMA=   # 任意の応答検証用 JSON オブジェクト。
# HV_LLM_TIMEOUT_SECONDS=60
# HV_LLM_MAX_RETRIES=2
# HV_LLM_RETRY_BACKOFF_MS=300
# SAKURA_AI_URL=https://api.ai.sakura.ad.jp/v1/chat/completions
# SAKURA_AI_TOKEN=

# 任意の AI 機能フラグ。
# HV_AI_JOURNAL_SCORE_ENABLED=true
# HV_AI_FEEDBACK_ENABLED=false
